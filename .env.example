ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000
# Modelo do Claude (troque sem mexer no código)
CLAUDE_MODEL=claude-sonnet-4-6
# Max requests per IP per day (across /api/plan and /api/replan)
DAILY_LIMIT_PER_IP=10
# Max output tokens per Claude call
MAX_OUTPUT_TOKENS=2500
# Teto global de requisições por dia (protege o orçamento de API)
GLOBAL_DAILY_LIMIT=500
